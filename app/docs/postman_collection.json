    {
     "name": "Duplicate recipient ids -> 202, deduplicated",
     "event": [
      {
       "listen": "test",
       "script": {
        "exec": [
         "pm.test('202 Accepted', () => pm.expect(pm.response.code).to.eql(202));",
         "const b = pm.response.json();",
         "pm.test('total is unique count (2)', () => pm.expect(b.total).to.eql(2));",
         "pm.test('two unique recipients', () => pm.expect(b.recipients.map(r => r.subscriber_id)).to.eql(['a', 'b']));"
        ],
        "type": "text/javascript"
