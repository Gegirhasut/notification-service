# ---------------------------------------------------------------------------
# Notification Service configuration. Copy to `.env`; compose reads this file.
# No secrets are committed — these are local-dev defaults for the compose stack.
# ---------------------------------------------------------------------------

# --- Postgres ---
POSTGRES_USER=notify
POSTGRES_PASSWORD=notify
POSTGRES_DB=notifications
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Async (app) and sync (alembic) URLs are derived from the above in config.py,
# but can be overridden explicitly here if needed.
# DATABASE_URL=postgresql+asyncpg://notify:notify@postgres:5432/notifications
# ALEMBIC_DATABASE_URL=postgresql+psycopg://notify:notify@postgres:5432/notifications

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=notify
RABBITMQ_DEFAULT_PASS=notify
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
# AMQP_URL=amqp://notify:notify@rabbitmq:5672/

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# REDIS_URL=redis://redis:6379/0

# --- Provider behaviour ---
# always_deliver | always_reject | transient_then_deliver | random
PROVIDER_MODE=random
# Simulated provider receipt delay (seconds) before it emits delivered/rejected.
PROVIDER_RECEIPT_DELAY=0.2

# --- Retry policy ---
MAX_RETRIES=3
# Fixed-delay retry tier TTLs (ms). Defaults match the tier names 5s/30s/120s.
RETRY_TTL_5S_MS=5000
RETRY_TTL_30S_MS=30000
RETRY_TTL_120S_MS=120000

# --- Rate limiting (outbound, per channel, per second) ---
RATE_LIMIT_SMS_PER_SEC=50
RATE_LIMIT_EMAIL_PER_SEC=100

# --- Idempotency ---
IDEMPOTENCY_TTL_SECONDS=86400

# --- Misc ---
LOG_LEVEL=INFO
